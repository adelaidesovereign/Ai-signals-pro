# -----------------------------------------------------------------------------
# The Quantum Engineer — environment variables
# Copy this file to .env.local for local development. All keys are required
# unless marked optional.
# -----------------------------------------------------------------------------

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. For Vercel, use a pooled URL.
DATABASE_URL="postgresql://user:password@host:5432/quantum_engineer?schema=public"
# Direct (non-pooled) URL used by Prisma migrate. Same host, no pgbouncer.
DIRECT_URL="postgresql://user:password@host:5432/quantum_engineer?schema=public"

# --- NextAuth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# The canonical site URL. In production, set to https://shesadelaide.com
NEXTAUTH_URL="http://localhost:3000"

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Webhook signing secret from `stripe listen` for local dev, or from the
# dashboard for production.
STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe Price IDs — create these as Products/Prices in the Stripe dashboard.
STRIPE_PRICE_FIELD_GUIDE="price_..."              # $27 one-time
STRIPE_PRICE_CERTIFICATION_FULL="price_..."       # $497 one-time
STRIPE_PRICE_CERTIFICATION_INSTALLMENT="price_..." # 3 x $167 payment plan
STRIPE_PRICE_INNER_CIRCLE="price_..."              # $97/month subscription

# --- ConvertKit --------------------------------------------------------------
# v4 API. Create a personal API key in ConvertKit under Account → API.
CONVERTKIT_API_KEY=""
CONVERTKIT_API_SECRET=""

# Form and tag IDs. Create these in ConvertKit first.
CONVERTKIT_FORM_QUIZ=""
CONVERTKIT_FORM_FOOTER=""
CONVERTKIT_TAG_FIELD_GUIDE_BUYER=""
CONVERTKIT_TAG_CERTIFICATION_BUYER=""
CONVERTKIT_TAG_INNER_CIRCLE_MEMBER=""
CONVERTKIT_TAG_QUIZ_LAYER_1=""
CONVERTKIT_TAG_QUIZ_LAYER_2=""
CONVERTKIT_TAG_QUIZ_LAYER_3=""
CONVERTKIT_TAG_QUIZ_LAYER_4=""
CONVERTKIT_TAG_QUIZ_LAYER_5=""
CONVERTKIT_TAG_QUIZ_LAYER_6=""
CONVERTKIT_TAG_QUIZ_LAYER_7=""

# --- Vercel Blob (optional, for future media upload) ------------------------
BLOB_READ_WRITE_TOKEN=""

# --- AI Coach (optional — Claude) -------------------------------------------
# Used by /api/coach and /api/coach/chat. When missing, the coach falls
# back to a warm template reply.
ANTHROPIC_API_KEY=""

# --- Soft voice TTS (optional — pick either one, ElevenLabs preferred) -----
# When either is set, every surface that speaks — the coach, the
# subliminals, the guided meditations — uses the premium voice.
#
# ElevenLabs: free tier 10k characters per month, no credit card required.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# Voice ID from https://elevenlabs.io/app/voice-library.
# Defaults to Rachel (warm, calm, female) when not set.
ELEVENLABS_VOICE_ID=""

# OpenAI TTS-1-HD with the "nova" voice. Requires credit on your OpenAI
# account. Used as a fallback if ElevenLabs is not configured.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=""
